#!/bin/sh
# Rebuild and reinstall /Applications/Ore.app when master gains a change to the desktop app or to what
# its compiled `ore` is built from (packages/, the root package.json, bun.lock, tsconfig; D30):
# a commit on master here, or a pull (post-merge runs this too). Branch worktrees share these
# hooks, so anything not on master returns at once. Runs in the background.
# Log: ~/Library/Caches/ore/app-install.log
[ "$(git rev-parse --abbrev-ref HEAD)" = master ] || exit 0
if [ -n "$ORE_HOOK_RANGE" ]; then changed=$(git diff --name-only "$ORE_HOOK_RANGE")
else changed=$(git diff-tree --no-commit-id --name-only -r HEAD); fi
echo "$changed" | grep -qE '^(apps/desktop|packages)/|^(package\.json|bun\.lock|tsconfig\.json)$' || exit 0
root=$(git rev-parse --show-toplevel)
cache="$HOME/Library/Caches/ore"
mkdir -p "$cache"
(
  cd "$root" || exit 1
  # One build at a time; the running build loops until it has installed the latest HEAD.
  mkdir "$cache/app-install.lock" 2>/dev/null || exit 0
  trap 'rmdir "$cache/app-install.lock"' EXIT
  built=
  while [ "$(git rev-parse HEAD)" != "$built" ]; do
    built=$(git rev-parse HEAD)
    echo "$(date): installing $(git rev-parse --short HEAD)"
    # A pulled change may add a dependency (PR #114's @tailwindcss/vite broke two reinstalls).
    if bun install --frozen-lockfile && bun run app:install; then echo "$(date): installed"; else echo "$(date): FAILED"; fi
  done
) >>"$cache/app-install.log" 2>&1 &
