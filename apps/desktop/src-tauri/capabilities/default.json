{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window and the quick quiz",
  "windows": ["main", "quiz"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    { "identifier": "opener:allow-open-url", "allow": [{ "url": "http://*" }, { "url": "https://*" }, { "url": "mailto:*" }] },
    { "identifier": "opener:allow-open-path", "allow": [{ "path": "$HOME/**" }, { "path": "/tmp/**" }, { "path": "/private/tmp/**" }] },
    "opener:allow-reveal-item-in-dir"
  ]
}
