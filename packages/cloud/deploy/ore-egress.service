# Puts firewall.sh's rules back after a restart of the host. deploy.sh installs it.
[Unit]
Description=Ore Cloud: close the server's network to private addresses
# Before Docker, so the containers it restarts never run without the rules.
Before=docker.service

[Service]
Type=oneshot
ExecStart=/bin/sh /opt/ore/packages/cloud/deploy/firewall.sh

[Install]
WantedBy=multi-user.target
