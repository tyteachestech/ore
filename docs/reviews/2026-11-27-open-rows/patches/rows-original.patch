+import { afterAll, afterEach, beforeAll, expect, test } from "bun:test";
+import { cpSync, existsSync, mkdirSync, mkdtempSync, readdirSync, readFileSync, rmSync, symlinkSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { dirname, join, sep } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import { parseHTML } from "linkedom";
+import { addSource, reimportSource, undoReimport } from "../src/ingest/index.ts";
+import { sourceFile } from "../src/items.ts";
+import { originalViewFile, savedHtmlView, writeOriginalView } from "../src/original-view.ts";
+import { tempLibrary } from "./helpers.ts";
+
+const fixture = join(import.meta.dir, "fixtures/intake/files/saved-lesson");
+// The combined suite includes happy-dom app tests. Intake itself runs without browser globals.
+const globals = globalThis as Record<string, unknown>;
+const browserGlobals = { window: globals.window, getComputedStyle: globals.getComputedStyle };
+beforeAll(() => { delete globals.window; delete globals.getComputedStyle; });
+afterAll(() => { for (const [key, value] of Object.entries(browserGlobals)) if (value !== undefined) globals[key] = value; });
+const roots: string[] = [];
+afterEach(() => { for (const dir of roots.splice(0)) rmSync(dir, { recursive: true, force: true }); });
+async function setup(extra = "") {
+  const lib = await tempLibrary();
+  const input = mkdtempSync(join(tmpdir(), "ore-original-view-"));
+  roots.push(lib.root, input);
+  cpSync(fixture, join(input, "page"), { recursive: true });
+  const path = join(input, "page/lesson.html");
+  writeFileSync(path, readFileSync(path, "utf8").replace("</article>", `${extra}</article>`));
+  return { lib, input, path };
+}
+function view(dir: string) {
+  const path = join(dir, "original-view.html");
+  expect(existsSync(path)).toBe(true);
+  return { path, document: parseHTML(readFileSync(path, "utf8")).document };
+}
+function linked(page: string, ref: string) {
+  const path = fileURLToPath(new URL(ref, pathToFileURL(page)));
+  expect(path.startsWith(dirname(page) + sep)).toBe(true);
+  return path;
+}
+
+test("F684: the offline original resolves its figure and preserves the captured bytes through reimport", async () => {
+  const { lib, input, path } = await setup();
+  const bytes = readFileSync(path);
+  const picture = readFileSync(join(dirname(path), "figure.png"));
+  const item = await addSource(lib, path);
+  const first = view(item.dir);
+  expect(readFileSync(linked(first.path, first.document.querySelector("img")!.getAttribute("src")!))).toEqual(picture);
+  expect(readFileSync(sourceFile(item)!)).toEqual(bytes);
+  const before = readFileSync(item.docPath);
+  rmSync(input, { recursive: true });
+  // Rebuild from the kept original and its saved files, even after the viewing HTML was removed.
+  rmSync(first.path);
+  expect((await reimportSource(lib, item.meta.id)).changed).toBe(false);
+  const again = view(item.dir);
+  expect(readFileSync(linked(again.path, again.document.querySelector("img")!.getAttribute("src")!))).toEqual(picture);
+  expect(readFileSync(sourceFile(item)!)).toEqual(bytes);
+  expect(readFileSync(item.docPath)).toEqual(before);
+});
+
+test("F684: local names cannot overwrite Ore files and references outside the page folder stay as written", async () => {
+  const { lib, input, path } = await setup(`<object data="source.html"></object><img id="thumb" src="thumbnail.png"><img id="assets" src="assets/figure.png"><a id="parent" href="../outside.txt">outside</a><a id="symlink" href="escape.txt">escape</a><a id="missing" href="missing.pdf">missing</a>`);
+  writeFileSync(join(dirname(path), "source.html"), "A different file, never Ore's original.");
+  cpSync(join(dirname(path), "figure.png"), join(dirname(path), "thumbnail.png"));
+  mkdirSync(join(dirname(path), "assets"));
+  cpSync(join(dirname(path), "figure.png"), join(dirname(path), "assets/figure.png"));
+  writeFileSync(join(input, "outside.txt"), "Outside the page folder");
+  symlinkSync(join(input, "outside.txt"), join(dirname(path), "escape.txt"));
+  const absolute = pathToFileURL(join(input, "outside.txt")).href;
+  const local = pathToFileURL(join(dirname(path), "figure.png")).href;
+  writeFileSync(path, readFileSync(path, "utf8").replace("</article>", `<a id="absolute" href="${absolute}">outside</a><img id="local" src="${local}"></article>`));
+  const bytes = readFileSync(path);
+  const item = await addSource(lib, path);
+  const { document, path: page } = view(item.dir);
+  expect(readFileSync(sourceFile(item)!)).toEqual(bytes);
+  expect(readFileSync(linked(page, document.querySelector("object")!.getAttribute("data")!), "utf8")).toBe("A different file, never Ore's original.");
+  for (const id of ["thumb", "assets", "local"]) expect(readFileSync(linked(page, document.getElementById(id)!.getAttribute("src")!))).toEqual(readFileSync(join(dirname(path), "figure.png")));
+  for (const [id, ref] of [["parent", "../outside.txt"], ["absolute", absolute], ["symlink", "escape.txt"], ["missing", "missing.pdf"]]) expect(document.getElementById(id!)!.getAttribute("href")).toBe(ref!);
+});
+
+test("F684: stylesheets, nested CSS images, srcset and inline styles keep their local files offline", async () => {
+  const { lib, path } = await setup(`<link rel="stylesheet" href="styles/main.css"><img id="responsive" src="figure.png" srcset="figure.png 1x, figure%20two.png 2x"><div id="styled" style="background: url('figure.png')"></div>`);
+  mkdirSync(join(dirname(path), "styles"));
+  writeFileSync(join(dirname(path), "styles/main.css"), '@import "colors.css"; .figure { background: url("../figure.png"); }');
+  writeFileSync(join(dirname(path), "styles/colors.css"), ".figure { color: green }");
