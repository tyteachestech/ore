+});
+
+test("F684: reimporting an older saved page creates a view without refusing its missing adjacent files", async () => {
+  const { lib, path } = await setup();
+  const item = await addSource(lib, path);
+  for (const name of ["original-view.html", "original-view.json", "original-files"]) rmSync(join(item.dir, name), { recursive: true, force: true });
+  expect(originalViewFile(item)).toBeUndefined();
+  const before = readFileSync(sourceFile(item)!);
+  expect((await reimportSource(lib, item.meta.id)).changed).toBe(false);
+  expect(readFileSync(sourceFile(item)!)).toEqual(before);
+  expect(view(item.dir).document.querySelector("img")!.getAttribute("src")).toBe("figure.png");
+});
+
+test("F684: list and reader answers offer the viewing copy separately from the kept original", async () => {
+  const { lib, path } = await setup();
+  const item = await addSource(lib, path);
+  for (const args of [["ls"], ["show", item.meta.id]]) {
+    const p = Bun.spawn([process.execPath, join(import.meta.dir, "../../cli/src/ore.ts"), ...args, "--json"], {
+      env: { ...process.env, ORE_LIBRARY: lib.root, ORE_NO_ENRICH: "1" }, stdout: "pipe", stderr: "pipe",
+    });
+    const [out, err, code] = await Promise.all([new Response(p.stdout).text(), new Response(p.stderr).text(), p.exited]);
