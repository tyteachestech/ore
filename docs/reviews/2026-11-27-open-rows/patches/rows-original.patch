new file mode 100644
index 0000000..d379e0e
--- /dev/null
+++ b/packages/core/src/original-view.ts
@@ -0,0 +1,182 @@
+import { existsSync, mkdirSync, readFileSync, realpathSync, statSync } from "node:fs";
+import { dirname, extname, join, relative, resolve, sep } from "node:path";
+import { createHash } from "node:crypto";
+import { writeAtomic } from "./fsutil.ts";
+import { ulid } from "./ids.ts";
+import type { Asset } from "./items.ts";
+
+/** Only derived files: source.* remains the byte-for-byte original. The manifest keeps raw local
+ *  dependencies so reimport can rebuild the view after the input folder has gone away. */
+export type OriginalView = { html: string; manifest: string; files: Asset[] };
+type Manifest = { base: string; source: string; files: Record<string, string> };
+export const VIEW_HTML = "original-view.html";
+export const VIEW_MANIFEST = "original-view.json";
+
+export function originalViewFile(item: { dir: string }): string | undefined {
+  const path = join(item.dir, VIEW_HTML);
+  return existsSync(path) ? path : undefined;
+}
+
+export function writeOriginalView(dir: string, view: OriginalView): void {
+  // Dependencies first; publish complete HTML with a rename. Old dependencies stay for Undo.
+  mkdirSync(join(dir, "original-files"), { recursive: true });
+  if (!inside(realpathSync(join(dir, "original-files")), realpathSync(dir))) throw new Error("The saved page's viewing files must stay inside its source folder.");
+  for (const file of view.files) {
+    if (!savedName(file.name)) throw new Error("Invalid saved page viewing file name");
+    writeAtomic(join(dir, file.name), file.data);
+  }
+  writeAtomic(join(dir, VIEW_MANIFEST), view.manifest);
+  writeAtomic(join(dir, VIEW_HTML), view.html);
+}
+
+const inside = (path: string, root: string) => path.startsWith(root + sep);
+const savedName = (name: string) => /^original-files\/[a-zA-Z0-9-]+\.[a-zA-Z0-9]+$/.test(name);
+const sha256 = (data: string | Uint8Array) => createHash("sha256").update(data).digest("hex");
+// The core runs in the phone's web view too, where node:url is not available.
+const fileUrl = (path: string) => new URL("file://" + resolve(path).split(sep).map(encodeURIComponent).join("/"));
+const localPath = (url: URL) => {
+  if (url.protocol !== "file:" || (url.hostname && url.hostname !== "localhost") || /%2f|%5c/i.test(url.pathname)) throw new Error("Not a local file path");
+  return decodeURIComponent(url.pathname);
+};
+
+/** A viewing copy of a local HTML file. `keptIn` reads only previously captured dependencies on
+ *  reimport, never the old input paths recorded in the manifest. A legacy source can read its own
+ *  folder. Paths are checked both before and after resolving symlinks. */
+export async function savedHtmlView(html: string, path: string, decode: (bytes: Uint8Array) => string, opts: { within?: string; keptIn?: string } = {}): Promise<OriginalView> {
+  const { parseHTML } = await import("linkedom");
+  let previous: Manifest | undefined;
+  if (opts.keptIn) {
+    try {
+      const data = JSON.parse(readFileSync(join(opts.keptIn, VIEW_MANIFEST), "utf8"));
+      if (typeof data.base === "string" && localPath(new URL(data.base)) && data.files && typeof data.files === "object") previous = data;
+    } catch { /* Older sources have no manifest. Their original still opens and imports as before. */ }
+  }
+  const base = previous?.base ?? fileUrl(path).href;
+  const root = dirname(localPath(new URL(base)));
+  const manifest: Manifest = { base, source: sha256(html), files: {} };
+  if (previous?.source === manifest.source && opts.keptIn && existsSync(join(opts.keptIn, VIEW_HTML))) {
+    return { html: readFileSync(join(opts.keptIn, VIEW_HTML), "utf8"), manifest: JSON.stringify(previous) + "\n", files: [] };
+  }
+  const files = new Map<string, Uint8Array>();
+  const rendered = new Map<string, string>();
+  const generation = ulid();
+
+  function read(url: URL): Uint8Array | undefined {
+    try {
+      const local = resolve(localPath(url));
+      if (!inside(local, root)) return;
+      let file = local;
+      let boundary = root;
+      if (previous && opts.keptIn) {
+        const saved = previous.files[url.href];
+        if (typeof saved !== "string" || !savedName(saved)) return;
+        file = join(opts.keptIn, saved);
+        boundary = resolve(opts.keptIn);
+      }
+      const real = realpathSync(file);
+      if (!inside(real, realpathSync(boundary))) return;
+      if (opts.within && !inside(real, realpathSync(opts.within))) return;
+      if (!statSync(real).isFile()) return;
+      return new Uint8Array(readFileSync(real));
+    } catch { return; } // A missing or unreadable neighbour stays linked exactly as it was.
+  }
+
+  function reference(value: string, from: string, output: string): string {
+    if (!value.trim() || value.trim().startsWith("#")) return value;
+    let url: URL;
+    try { url = new URL(value, from); } catch { return value; }
+    if (url.protocol !== "file:") return /^https?:/.test(from) ? url.href : value;
+    const suffix = url.search + url.hash;
+    url.search = "";
+    url.hash = "";
+    let target = rendered.get(url.href);
+    if (!target) {
+      const data = read(url);
+      if (!data) return value;
+      const ext = extname(url.pathname).slice(1).toLowerCase();
+      const ending = /^[a-z0-9]{1,12}$/.test(ext) ? ext : "bin";
+      const raw = `original-files/${sha256(data)}.${ending}`;
+      manifest.files[url.href] = raw;
+      files.set(raw, data);
+      // Assign before following dependencies: two stylesheets can import each other.
+      target = ["css", "html", "htm"].includes(ext) ? `original-files/${generation}-${sha256(url.href)}.${ending}` : raw;
+      rendered.set(url.href, target);
+      if (ext === "css") files.set(target, new TextEncoder().encode(css(decode(data), url.href, target)));
+      else if (ext === "html" || ext === "htm") files.set(target, new TextEncoder().encode(page(decode(data), url.href, target)));
+    }
+    return relative(dirname(output), target).split(sep).join("/") + suffix;
+  }
+
+  function css(text: string, from: string, output: string): string {
+    // Keep strings and comments intact; rewrite URLs and the string form of @import only.
+    return text.replace(/\/\*[\s\S]*?\*\/|url\(\s*(?:"([^"\n]*)"|'([^'\n]*)'|([^\s)]+))\s*\)|(@import\s+)(["'])([^"'\n]+)\5|"(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*'/gi,
+      (all, double: string | undefined, single: string | undefined, bare: string | undefined, imp: string | undefined, quote: string, imported: string) => {
+        if (imp) return `${imp}${quote}${reference(imported, from, output)}${quote}`;
+        const value = double ?? single ?? bare;
+        if (value === undefined) return all;
+        const next = reference(value, from, output);
+        return next === value ? all : `url(${double !== undefined ? '"' : single !== undefined ? "'" : ""}${next}${double !== undefined ? '"' : single !== undefined ? "'" : ""})`;
+      });
+  }
+
+  function srcset(text: string, from: string, output: string): string {
+    let result = "", cursor = 0;
+    while (cursor < text.length) {
+      const leading = /^[\s,]*/.exec(text.slice(cursor))![0];
+      result += leading;
+      cursor += leading.length;
+      const token = /^\S+/.exec(text.slice(cursor))?.[0];
+      if (!token) break;
+      cursor += token.length;
+      const url = token.replace(/,+$/, "");
+      result += reference(url, from, output) + token.slice(url.length);
+      if (url.length !== token.length) continue;
+      // Descriptors end at the next comma, except inside parentheses. Commas inside a URL
+      // (notably data:) were consumed as part of that URL above.
+      const start = cursor;
+      let parens = 0;
+      while (cursor < text.length) {
+        const ch = text[cursor++]!;
+        if (ch === "(") parens++;
+        if (ch === ")") parens--;
+        if (ch === "," && parens === 0) break;
+      }
+      result += text.slice(start, cursor);
+    }
+    return result;
+  }
+
+  function page(text: string, from: string, output: string): string {
+    const { document } = parseHTML(text);
+    if (!document.documentElement) return text;
+    // Keep <base> semantics while making copied URLs relative to this viewing file.
+    const baseElement = document.querySelector("base[href]");
+    let at = from;
+    try { if (baseElement) at = new URL(baseElement.getAttribute("href")!, from).href; } catch {}
+    for (const element of document.querySelectorAll("*")) {
+      if (element.tagName === "BASE") continue;
+      for (const attr of ["src", "href", "poster", "data", "background", "xlink:href"]) {
+        const value = element.getAttribute(attr);
+        if (value === null) continue;
+        element.setAttribute(attr, reference(value, at, output));
+      }
+      for (const attr of ["srcset", "imagesrcset"]) {
+        const value = element.getAttribute(attr);
+        if (value !== null) element.setAttribute(attr, srcset(value, at, output));
+      }
+      const style = element.getAttribute("style");
+      if (style !== null) element.setAttribute("style", css(style, at, output));
+      if (element.tagName === "STYLE") element.textContent = css(element.textContent ?? "", at, output);
+    }
+    for (const element of document.querySelectorAll("base[href]")) element.removeAttribute("href");
+    // The derived file is UTF-8 even when the captured original used another encoding.
+    for (const meta of document.querySelectorAll('meta[charset], meta[http-equiv="Content-Type" i]')) meta.remove();
+    const charset = document.createElement("meta");
+    charset.setAttribute("charset", "utf-8");
+    document.head.prepend(charset);
+    return document.toString();
+  }
+
+  const viewing = page(html, base, VIEW_HTML);
+  return { html: viewing, manifest: JSON.stringify(manifest) + "\n", files: [...files].map(([name, data]) => ({ name, data })) };
+}
