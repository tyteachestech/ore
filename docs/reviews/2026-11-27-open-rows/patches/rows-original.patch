+    expect(source.original_view).toBe(originalViewFile(item));
+  }
+});
+
+test("F684: unchanged reimports reuse the view and re-adding a legacy original supplies its files", async () => {
+  const { lib, path } = await setup('<link rel="stylesheet" href="style.css">');
+  writeFileSync(join(dirname(path), "style.css"), "body { color: green }");
+  const item = await addSource(lib, path);
+  const names = readdirSync(join(item.dir, "original-files"));
+  const html = readFileSync(view(item.dir).path);
