+  const { document, path: page } = view(item.dir);
+  const cssPath = linked(page, document.querySelector("link")!.getAttribute("href")!);
+  const css = readFileSync(cssPath, "utf8");
+  for (const ref of [css.match(/@import "([^"]+)"/)![1]!, css.match(/url\("([^"]+)"\)/)![1]!]) {
+    const p = fileURLToPath(new URL(ref, pathToFileURL(cssPath)));
+    expect(p.startsWith(item.dir + sep)).toBe(true);
+    expect(existsSync(p)).toBe(true);
+  }
+  for (const candidate of document.getElementById("responsive")!.getAttribute("srcset")!.split(",")) expect(existsSync(linked(page, candidate.trim().split(/\s+/)[0]!))).toBe(true);
+  expect(existsSync(linked(page, document.getElementById("styled")!.getAttribute("style")!.match(/url\('([^']+)'\)/)![1]!))).toBe(true);
+});
+
+test("F684: reimport and Undo keep the matching viewing copy without changing the original", async () => {
+  const { lib, path } = await setup();
+  const item = await addSource(lib, path);
+  const original = readFileSync(sourceFile(item)!);
