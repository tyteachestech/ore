@@ -0,0 +1,23 @@
+import { expect, test } from "bun:test";
+
+// Isolate the opener mock so this never opens an app or changes other tests' native boundary.
+test("F684: Open original uses the offline copy, with the original and web link as fallbacks", async () => {
+  const script = `
+    import { mock } from "bun:test";
+    const opened = [];
+    mock.module("@tauri-apps/plugin-opener", () => ({
+      openPath: async p => opened.push(p), openUrl: async p => opened.push(p), revealItemInDir: async () => {},
+    }));
+    const { openOriginal, pathOf } = await import("./src/original.ts");
+    const item = { dir: "/source", source_file: "/source/source.html", original_view: "/source/original-view.html" };
+    await openOriginal(item);
+    await openOriginal({ ...item, original_view: undefined });
+    await openOriginal({ ...item, url: "https://example.com/page" });
+    console.log(JSON.stringify({ opened, copied: pathOf(item) }));
+  `;
+  const p = Bun.spawn([process.execPath, "-e", script], { cwd: `${import.meta.dir}/..`, stdout: "pipe", stderr: "pipe" });
+  const [out, err, code] = await Promise.all([new Response(p.stdout).text(), new Response(p.stderr).text(), p.exited]);
+  expect(err).toBe("");
+  expect(code).toBe(0);
+  expect(JSON.parse(out)).toEqual({ opened: ["/source/original-view.html", "/source/source.html", "https://example.com/page"], copied: "/source/source.html" });
+});
