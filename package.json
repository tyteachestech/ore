{
  "name": "ore",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "packages/*",
    "apps/desktop"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/desktop/tsconfig.json --noEmit",
    "app:install": "bun run --cwd apps/desktop app:install",
    "intake:live": "bun packages/core/scripts/intake-live.ts",
    "corpus": "bun packages/core/corpus/run.ts",
    "eval:grade": "bun packages/core/eval/grade.ts",
    "eval:mine": "bun packages/core/eval/mine.ts",
    "eval:mine:tutor": "bun packages/core/eval/mine-tutor.ts",
    "eval:ask": "bun packages/core/eval/ask.ts",
    "eval:tutor": "bun packages/core/eval/tutor.ts",
    "eval:questions": "bun packages/core/eval/questions.ts",
    "eval:transcripts": "bun packages/core/eval/transcripts.ts",
    "golden:update": "ORE_UPDATE_GOLDEN=1 bun test packages/core/test/golden.test.ts",
    "e2e": "bun apps/desktop/e2e/journeys.ts",
    "release:check": "bun apps/desktop/e2e/release-check.ts",
    "bench": "bun apps/desktop/scripts/bench.ts",
    "ids": "bun packages/core/scripts/ids.ts",
    "sweep": "bun apps/desktop/scripts/sweep.ts",
    "ship": "bun packages/core/scripts/ship.ts",
    "phone:install": "bun apps/phone/scripts/install.ts",
    "auto-update": "bun apps/desktop/scripts/auto-update.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "axe-core": "4.11.1",
    "playwright": "1.63.0",
    "typescript": "^7.0.2"
  },
  "patchedDependencies": {
    "defuddle@0.19.4": "patches/defuddle@0.19.4.patch"
  }
}
